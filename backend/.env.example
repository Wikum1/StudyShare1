# Copy this file to .env in the same folder (backend/) and fill in your values.
# Never commit .env — it is listed in .gitignore.

# MongoDB Atlas (or local): required for users, profiles, resources, etc.
# Example Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/studyshare?retryWrites=true&w=majority
MONGODB_URI=

# Must match the secret used when issuing JWTs (login/register).
JWT_SECRET=

# Optional — server.js uses 5000 by default
# PORT=5000
